---
import { t, type Lang } from '@/content/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string; // path after /{lang}, e.g. '' or '/sioa'
  home?: boolean;
}
const { lang, title, description, path = '', home = false } = Astro.props;
const tx = t[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" hreflang="es" href={`/es${path}`} />
    <link rel="alternate" hreflang="en" href={`/en${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap row between center wrap-gap">
        <a href={`/${lang}`} class="logo">Luis Silva</a>
        {
          home ? (
            <nav class="navlinks" aria-label="Secciones">
              <a href="#casos">{tx.nav.cases}</a>
              <a href="#trayectoria">{tx.nav.path}</a>
              <a href="#stack">{tx.nav.stack}</a>
              <a href="#contacto">{tx.nav.contact}</a>
            </nav>
          ) : (
            <a href={`/${lang}#casos`} class="navback">{tx.nav.back}</a>
          )
        }
        <div class="row center gap16 mono small muted">
          <span class="hide-sm">{tx.place} · 8°06′S 79°02′W · <span data-clock>--:--</span></span>
          <div class="lang" role="group" aria-label="Idioma / Language">
            <a href={`/es${path}`} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
            <a href={`/en${path}`} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </div>
        </div>
      </div>
    </header>
    <slot />
    <script is:inline>
      (function () {
        function tick() {
          var s = new Date().toLocaleTimeString('es-PE', { timeZone: 'America/Lima', hour: '2-digit', minute: '2-digit' });
          document.querySelectorAll('[data-clock]').forEach(function (el) { el.textContent = s; });
        }
        tick();
        setInterval(tick, 30000);
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var label = btn.textContent;
            try { navigator.clipboard.writeText(btn.getAttribute('data-copy')); } catch (e) {}
            btn.textContent = btn.getAttribute('data-copied');
            setTimeout(function () { btn.textContent = label; }, 2000);
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4efe6; --surface: #fbf8f2; --line: #d9d1c3; --ink: #12232e; --muted: #4a5a63;
    --sea: #0e6b73; --coral: #b8461f; --seaSoft: #dcebea; --chip: #eae3d6;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1a22; --surface: #132a33; --line: #24414c; --ink: #e8e2d6; --muted: #93a4ac;
      --sea: #5cc2bd; --coral: #f08a62; --seaSoft: #16363d; --chip: #1a3540;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 72px; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 17px; line-height: 1.6; }
  a { color: var(--sea); }
  a:hover { color: var(--ink); }
  img { max-width: 100%; }
  h1, h2, h3 { margin: 0; font-family: 'Instrument Serif', serif; font-weight: 400; }
  p { margin: 0; }
  .wrap { max-width: 1200px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
  .row { display: flex; }
  .col { display: flex; flex-direction: column; }
  .between { justify-content: space-between; }
  .center { align-items: center; }
  .wrap-gap { flex-wrap: wrap; gap: 16px; }
  .gap8 { gap: 8px; } .gap12 { gap: 12px; } .gap16 { gap: 16px; } .gap18 { gap: 18px; } .gap24 { gap: 24px; } .gap28 { gap: 28px; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .small { font-size: 12px; }
  .muted { color: var(--muted); }
  .sea { color: var(--sea); } .coral { color: var(--coral); }
  .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
  .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 13px; }
  .site-header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); }
  .site-header .wrap { padding-top: 14px; padding-bottom: 14px; }
  .logo { font-family: 'Instrument Serif', serif; font-size: 26px; color: var(--ink); text-decoration: none; }
  .navlinks { display: flex; gap: 28px; font-size: 15px; }
  .navlinks a, .navback { color: var(--muted); text-decoration: none; }
  .navback { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: var(--sea); }
  .lang { display: flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .lang a { padding: 6px 12px; min-height: 32px; color: var(--muted); text-decoration: none; }
  .lang a[aria-current='true'] { background: var(--ink); color: var(--bg); }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 999px; text-decoration: none; font: inherit; font-weight: 500; cursor: pointer; }
  .btn-solid { background: var(--ink); color: var(--bg); border: 0; }
  .btn-solid:hover { color: var(--bg); opacity: 0.9; }
  .btn-ghost { border: 1px solid var(--ink); color: var(--ink); background: transparent; }
  .btn-soft { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .link-strong { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: none; }
  .card { display: flex; flex-direction: column; gap: 18px; padding: 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; }
  .tile { padding: 24px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .pill { padding: 4px 10px; border-radius: 999px; }
  .grid-auto { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min, 220px)), 1fr)); }
  .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; border-top: 1px solid var(--line); padding-top: 18px; }
  .stat-n { font-family: 'IBM Plex Mono', monospace; font-size: 28px; line-height: 1.2; }
  .stat-l { font-size: 13px; color: var(--muted); }
  .big .stat-n { font-size: 40px; }
  .big .stat-l { font-size: 16px; }
  .h2 { font-size: 48px; line-height: 1.1; }
  .h2s { font-size: 36px; line-height: 1.1; }
  .section { padding-top: 96px; }
  .shot { display: block; width: 100%; height: auto; border-radius: 18px; border: 1px solid var(--line); background: #fff; }
  @media (max-width: 760px) {
    .navlinks, .hide-sm { display: none !important; }
    .h2 { font-size: 38px; }
    .card { padding: 24px; }
    .grid3 .stat-n { font-size: 22px; }
    .section { padding-top: 72px; }
  }
</style>

---
import { t, poster, type Lang } from '@/content/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string; // path after /{lang}, e.g. '' or '/sioa'
  home?: boolean;
}
const { lang, title, description, path = '', home = false } = Astro.props;
const tx = t[lang];
const px = poster[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" hreflang="es" href={`/es${path}`} />
    <link rel="alternate" hreflang="en" href={`/en${path}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <a href={`/${lang}`} class="brand">Luis Silva — Full stack / IA</a>
      <span class="live-wrap hide-sm"><span class="live"></span>{px.live}</span>
      <nav class="row center gap20" aria-label="Secciones">
        {
          home ? (
            <>
              <a href="#obra" class="hide-sm">{px.work}</a>
              <a href="#hablemos" class="hide-sm">{px.talkNav}</a>
            </>
          ) : (
            <a href={`/${lang}#obra`}>{tx.nav.back}</a>
          )
        }
        <span class="lang">
          <a href={`/es${path}`} aria-current={lang === 'es' ? 'true' : undefined}>ES</a> /
          <a href={`/en${path}`} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </span>
      </nav>
    </header>
    <slot />
    <script is:inline>
      document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var label = btn.textContent;
          try { navigator.clipboard.writeText(btn.getAttribute('data-copy')); } catch (e) {}
          btn.textContent = btn.getAttribute('data-copied');
          setTimeout(function () { btn.textContent = label; }, 2000);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ecebe6; --ink: #0a0a0a; --muted: #4a4a46; --red: #ff3b1f; --redInk: #c42a12; --paper: #f7f6f1;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0a0a0a; --ink: #ecebe6; --muted: #a8a7a0; --red: #ff5a3d; --redInk: #ff5a3d; --paper: #151514; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 64px; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Space Mono', monospace; font-size: 15px; line-height: 1.6; }
  a { color: var(--ink); }
  a:hover { color: var(--redInk); }
  img { max-width: 100%; }
  h1, h2, h3 { margin: 0; }
  p { margin: 0; }
  .display { font-family: 'Archivo', sans-serif; font-stretch: 125%; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; }
  .cond { font-family: 'Archivo', sans-serif; font-stretch: 62%; font-weight: 900; text-transform: uppercase; }
  .caps { text-transform: uppercase; font-size: 12px; letter-spacing: 0.08em; }
  .muted { color: var(--muted); }
  .row { display: flex; } .center { align-items: center; } .gap20 { gap: 20px; }
  .pad { padding-left: 24px; padding-right: 24px; }
  .site-header { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 14px 24px; background: var(--bg); border-bottom: 2px solid var(--ink); text-transform: uppercase; font-size: 12px; letter-spacing: 0.08em; }
  .site-header a { text-decoration: none; }
  .brand { font-weight: 700; }
  .live-wrap { display: flex; align-items: center; gap: 8px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: pulse 1.6s infinite; }
  .lang a[aria-current='true'] { color: var(--redInk); text-decoration: underline; text-underline-offset: 3px; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border: 2px solid var(--ink); background: transparent; color: var(--ink); text-decoration: none; text-transform: uppercase; font: inherit; font-weight: 700; cursor: pointer; transition: background 0.25s, color 0.25s; }
  .btn:hover { background: var(--ink); color: var(--bg); }
  .btn-solid { background: #0a0a0a; color: #ecebe6; border-color: #0a0a0a; }
  .btn-solid:hover { background: transparent; color: #0a0a0a; }
  .btn-on-red { border-color: #0a0a0a; color: #0a0a0a; }
  .btn-on-red:hover { background: #0a0a0a; color: #ecebe6; }
  .mask { display: block; overflow: hidden; }
  .mask > span { display: block; animation: up 0.9s cubic-bezier(0.77, 0, 0.175, 1) both; }
  .photo { filter: grayscale(1) contrast(1.12); transition: filter 0.6s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .hover-color:hover .photo { filter: none; transform: scale(1.03); }
  @keyframes up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes pulse { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) {
    .mask > span, .live { animation: none; }
    .photo, .btn { transition: none; }
  }
  @media (max-width: 760px) {
    .hide-sm { display: none !important; }
  }
</style>

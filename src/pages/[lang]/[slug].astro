---
import Site from '@/layouts/Site.astro';
import { t, cases, langs, type Lang } from '@/content/site';

export const prerender = true;
export function getStaticPaths() {
  return langs.flatMap((lang) => cases[lang].map((c) => ({ params: { lang, slug: c.slug } })));
}

const lang = Astro.params.lang as Lang;
const tx = t[lang];
const c = cases[lang].find((x) => x.slug === Astro.params.slug)!;
// ponytail: Harmony leads with its numbers; the kicker numbering already says so
const statsFirst = c.stats.kicker.startsWith('01');
const order = statsFirst ? ['stats', 'features'] : ['features', 'stats'];
---

<Site lang={lang} title={`${c.title} · Luis Silva`} description={c.lead ?? c.title} path={`/${c.slug}`}>
  <main>
    <section class="pad intro">
      <span class="caps" style="color: var(--redInk)">{c.kicker}</span>
      <h1 class="display case-title">{c.title}</h1>
      {c.lead && <p class="lead">{c.lead}</p>}
      <div class="meta">
        {c.meta.map((m) => <div><div class="caps muted">{m.k}</div><div>{m.v}</div></div>)}
      </div>
    </section>

    {
      c.images.length > 0 && (
        <section class="pad shots">
          {c.images.map((img) => (
            <figure class="hover-color">
              <div class="frame"><img class="photo" src={img.src} alt={img.alt} loading="lazy" /></div>
              <figcaption class="caps muted">{img.caption}</figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      c.problem && (
        <section class="pad split">
          <div class="head">
            <span class="caps" style="color: var(--redInk)">{c.problem.kicker}</span>
            <h2 class="cond h2">{c.problem.h}</h2>
          </div>
          <p class="body">{c.problem.p}</p>
        </section>
      )
    }

    {
      order.map((block) =>
        block === 'features' ? (
          <>
            <section class="pad block">
              <span class="caps" style="color: var(--redInk)">{c.features.kicker}</span>
              <h2 class="cond h2">{c.features.h}</h2>
              <div class="tiles">
                {c.features.items.map((f) => (
                  <div class="tile">
                    <strong class="display" style="font-size: 20px">{f.t}</strong>
                    <span>{f.d}</span>
                  </div>
                ))}
              </div>
            </section>
            {c.list && (
              <section class="pad split">
                <div class="head">
                  <span class="caps" style="color: var(--redInk)">{c.list.kicker}</span>
                  <h2 class="cond h2">{c.list.h}</h2>
                </div>
                <ul class="lines body">{c.list.items.map((i) => <li>{i}</li>)}</ul>
              </section>
            )}
          </>
        ) : (
          <section class="pad block">
            <span class="caps" style="color: var(--redInk)">{c.stats.kicker}</span>
            <h2 class="cond h2">{c.stats.h}</h2>
            <div class="stats">
              {c.stats.items.map((s) => (
                <div class="stat">
                  <div class="display stat-n">{s.n}</div>
                  <div class="caps">{s.l}</div>
                </div>
              ))}
            </div>
          </section>
        )
      )
    }

    <section class="pad block" style="padding-bottom: 96px">
      <div class="contrib">
        <div class="contrib-head">
          <span class="caps">{c.contribution.kicker}</span>
          {c.contribution.stat && <div class="display" style="font-size: 48px; line-height: 1">{c.contribution.stat.n}</div>}
          {c.contribution.stat && <span class="caps">{c.contribution.stat.l}</span>}
        </div>
        {
          c.contribution.items.some((i) => i.t) ? (
            <div class="tiles" style="flex: 3 1 520px">
              {c.contribution.items.map((i) => (
                <div class="tile" style="background: var(--paper); color: var(--ink)">
                  <strong class="display" style="font-size: 18px">{i.t}</strong>
                  <span style="font-size: 14px">{i.d}</span>
                </div>
              ))}
            </div>
          ) : (
            <ul class="lines" style="flex: 3 1 520px; border-color: #0a0a0a">{c.contribution.items.map((i) => <li>{i.d}</li>)}</ul>
          )
        }
      </div>
    </section>

    <a href={`/${lang}/${c.next.slug}`} class="next pad">
      <span class="caps">{tx.nextCase}</span>
      <span class="display next-name">{c.next.label} →</span>
    </a>
  </main>
</Site>

<style>
  .intro { padding-top: 64px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 20px; }
  .case-title { font-size: clamp(40px, 6vw, 88px); line-height: 0.92; max-width: 1100px; }
  .lead { max-width: 680px; font-size: 17px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; padding-top: 20px; border-top: 2px solid var(--ink); }
  .shots { display: flex; flex-direction: column; gap: 24px; }
  .shots figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .frame { border: 2px solid var(--ink); overflow: hidden; background: #fff; }
  .frame img { display: block; width: 100%; height: auto; }
  .split { padding-top: 72px; display: flex; flex-wrap: wrap; gap: 24px 64px; }
  .head { flex: 1 1 300px; display: flex; flex-direction: column; gap: 8px; }
  .body { flex: 2 1 520px; font-size: 16px; }
  .h2 { font-size: clamp(40px, 5vw, 64px); line-height: 0.92; }
  .block { padding-top: 72px; display: flex; flex-direction: column; gap: 20px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0; border-top: 2px solid var(--ink); border-left: 2px solid var(--ink); }
  .tile { padding: 22px; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); display: flex; flex-direction: column; gap: 8px; transition: background 0.25s, color 0.25s; }
  .tile:hover { background: var(--red); color: #0a0a0a; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); border-top: 2px solid var(--ink); }
  .stat { padding: 20px 16px 20px 0; display: flex; flex-direction: column; gap: 6px; }
  .stat-n { font-size: clamp(40px, 5vw, 64px); line-height: 0.95; }
  .lines { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 2px solid var(--ink); }
  .lines li { padding: 14px 0; border-bottom: 2px solid var(--ink); }
  .contrib { display: flex; flex-wrap: wrap; gap: 24px 48px; padding: 28px; border: 2px solid var(--ink); background: var(--red); color: #0a0a0a; }
  .contrib .lines, .contrib .lines li { border-color: #0a0a0a; }
  .contrib-head { flex: 1 1 200px; display: flex; flex-direction: column; gap: 10px; }
  .next { display: flex; flex-direction: column; gap: 8px; padding-top: 40px; padding-bottom: 48px; background: #0a0a0a; color: #ecebe6; text-decoration: none; border-top: 2px solid var(--ink); }
  .next:hover { color: #ff5a3d; }
  .next-name { font-size: clamp(48px, 9vw, 140px); line-height: 0.9; }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>

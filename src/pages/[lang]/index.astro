---
import Site from '@/layouts/Site.astro';
import { t, links, langs, type Lang } from '@/content/site';

export const prerender = true;
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const tx = t[lang];
const c = tx.cards;
const wave = [10, 18, 30, 44, 36, 22, 14, 26, 48, 62, 54, 40, 28, 20, 34, 52, 70, 58, 42, 30, 22, 16, 28, 40, 56, 46, 32, 20, 14, 24, 18, 10];
const laneColor: Record<string, [string, string]> = {
  sea: ['var(--sea)', 'var(--bg)'],
  ink: ['var(--ink)', 'var(--bg)'],
  coral: ['var(--coral)', 'var(--bg)'],
  muted: ['var(--muted)', 'var(--bg)'],
  line: ['var(--line)', 'var(--ink)'],
};
---

<Site lang={lang} title={tx.meta.title} description={tx.meta.description} home>
  <main>
    <section id="inicio" class="hero">
      <svg aria-hidden="true" class="contour" viewBox="0 0 1600 640" preserveAspectRatio="none">
        <g fill="none" stroke="var(--line)" stroke-width="1.2">
          <path d="M0 120 C 220 80, 420 170, 640 130 S 1060 60, 1280 120 S 1520 170, 1600 140"></path>
          <path d="M0 190 C 240 150, 440 240, 660 200 S 1080 130, 1300 190 S 1530 240, 1600 210"></path>
          <path d="M0 260 C 260 220, 460 310, 680 270 S 1100 200, 1320 260 S 1540 310, 1600 280"></path>
          <path d="M0 330 C 280 290, 480 380, 700 340 S 1120 270, 1340 330 S 1550 380, 1600 350"></path>
          <path d="M0 400 C 300 360, 500 450, 720 410 S 1140 340, 1360 400 S 1560 450, 1600 420"></path>
          <path d="M0 470 C 320 430, 520 520, 740 480 S 1160 410, 1380 470 S 1570 520, 1600 490"></path>
          <path d="M0 540 C 340 500, 540 590, 760 550 S 1180 480, 1400 540 S 1580 590, 1600 560"></path>
        </g>
        <path fill="none" stroke="var(--sea)" stroke-width="1.4" opacity="0.5" d="M0 300 C 270 255, 470 345, 690 305 S 1110 235, 1330 295 S 1545 345, 1600 315"></path>
      </svg>
      <div class="wrap col gap28 hero-inner">
        <p class="eyebrow sea">{tx.hero.eyebrow}</p>
        <h1 class="hero-title">{tx.hero.title[0]}<em class="sea">{tx.hero.title[1]}</em>{tx.hero.title[2]}</h1>
        <p class="hero-lead muted">{tx.hero.lead}</p>
        <div class="row wrap-gap gap12">
          <a href="#casos" class="btn btn-solid">{tx.hero.ctaCases}</a>
          <a href={tx.hero.cv} class="btn btn-ghost" download>{tx.hero.ctaCv}</a>
          <button type="button" class="btn btn-soft" data-copy={links.email} data-copied={tx.hero.copied}>{tx.hero.copy}</button>
        </div>
      </div>
    </section>

    <section id="casos" class="wrap section">
      <div class="row between wrap-gap" style="align-items: baseline; padding-bottom: 36px">
        <h2 class="h2">{tx.casesTitle}</h2>
        <span class="mono muted" style="font-size: 13px">01 — 04</span>
      </div>
      <div class="grid-auto" style="--min: 520px; gap: 24px">
        <article class="card">
          <div class="row between mono small muted"><span class="pill" style="background: var(--seaSoft); color: var(--sea)">{c.sioa.tag}</span><span>{c.sioa.dates}</span></div>
          <div class="visual" style="background: var(--seaSoft); align-items: flex-end">
            <svg aria-hidden="true" viewBox="0 0 480 160" preserveAspectRatio="none" class="fill">
              <g stroke="var(--sea)" stroke-width="1.5" opacity="0.7">
                <line x1="40" y1="28" x2="40" y2="140"></line><line x1="110" y1="28" x2="110" y2="140"></line><line x1="180" y1="28" x2="180" y2="140"></line><line x1="250" y1="28" x2="250" y2="140"></line><line x1="320" y1="28" x2="320" y2="140"></line><line x1="390" y1="28" x2="390" y2="140"></line>
              </g>
              <line x1="0" y1="28" x2="480" y2="28" stroke="var(--ink)" stroke-width="1" opacity="0.4"></line>
              <g fill="var(--coral)"><circle cx="40" cy="70" r="5"></circle><circle cx="40" cy="104" r="5"></circle><circle cx="110" cy="84" r="5"></circle><circle cx="180" cy="62" r="5"></circle><circle cx="180" cy="98" r="5"></circle><circle cx="180" cy="128" r="5"></circle><circle cx="250" cy="90" r="5"></circle><circle cx="320" cy="70" r="5"></circle><circle cx="320" cy="112" r="5"></circle></g>
            </svg>
            <span class="mono small" style="position: relative">{c.sioa.visual}</span>
          </div>
          <h3 class="card-title">SIOA</h3>
          <p class="muted">{c.sioa.desc}</p>
          <div class="grid3">{c.sioa.stats.map((s) => <div><div class="stat-n">{s.n}</div><div class="stat-l">{s.l}</div></div>)}</div>
          <div class="row between center wrap-gap">
            <span class="mono small muted">{c.sioa.stack}</span>
            <a href={`/${lang}/sioa`} class="link-strong">{tx.seeCase}</a>
          </div>
        </article>

        <article class="card">
          <div class="row between mono small muted"><span class="pill" style="background: var(--chip); color: var(--coral)">{c.harmony.tag}</span><span>{c.harmony.dates}</span></div>
          <div class="visual qr-visual" style="background: var(--chip)">
            <div class="qr-phone">
              <svg aria-hidden="true" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.6"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><path d="M14 14h3v3h-3zM18 18h3v3h-3z"></path></svg>
              <span class="mono muted" style="font-size: 11px">{c.harmony.table}</span>
            </div>
            <div class="ticket mono">{c.harmony.ticket}</div>
            <div class="qr-pos">
              <span class="mono muted" style="font-size: 11px">{c.harmony.pos}</span>
              <span class="ping mono">{c.harmony.ping}</span>
              <span class="mono muted" style="font-size: 11px">{c.harmony.stock}</span>
            </div>
          </div>
          <h3 class="card-title">Harmony</h3>
          <p class="muted">{c.harmony.desc}</p>
          <div class="grid3">{c.harmony.stats.map((s) => <div><div class="stat-n">{s.n}</div><div class="stat-l">{s.l}</div></div>)}</div>
          <div class="row between center wrap-gap">
            <span class="mono small muted">{c.harmony.stack}</span>
            <span class="row gap18"><a href={links.harmonyDemo} class="link-strong">{tx.demo}</a><a href={`/${lang}/harmony`} class="link-strong">{tx.seeCase}</a></span>
          </div>
        </article>

        <article class="card">
          <div class="row between mono small muted"><span class="pill" style="background: var(--chip); color: var(--ink)">{c.domus.tag}</span><span>{c.domus.dates}</span></div>
          <div class="col gap8" style="padding: 18px; border-radius: 14px; background: var(--seaSoft)">
            <span class="bubble-in">{c.domus.chatIn}</span>
            <span class="bubble-out">{c.domus.chatOut}</span>
          </div>
          <h3 class="card-title">{c.domus.title}</h3>
          <p class="muted">{c.domus.desc}</p>
          <div class="grid3">{c.domus.stats.map((s) => <div><div class="stat-n">{s.n}</div><div class="stat-l">{s.l}</div></div>)}</div>
          <div class="row between center wrap-gap">
            <span class="mono small muted">{c.domus.stack}</span>
            <a href={`/${lang}/domus`} class="link-strong">{tx.seeCase}</a>
          </div>
        </article>

        <article class="card">
          <div class="row between mono small muted"><span class="pill" style="background: var(--chip); color: var(--ink)">{c.voice.tag}</span><span>{c.voice.dates}</span></div>
          <div class="row center" style="height: 120px; border-radius: 14px; background: var(--chip); justify-content: center; gap: 4px; padding: 0 24px">
            {wave.map((h) => <span style={`display:block;width:6px;border-radius:3px;background:var(--sea);height:${h}px`}></span>)}
          </div>
          <h3 class="card-title">Voice Quiz</h3>
          <p class="muted">{c.voice.desc}</p>
          <div class="row between center wrap-gap">
            <span class="mono small muted">{c.voice.stack}</span>
            <span class="row gap18"><a href={links.voiceQuiz} class="link-strong">{tx.demo}</a><a href={links.voiceQuizCode} class="link-strong">{tx.code}</a></span>
          </div>
        </article>
      </div>
    </section>

    <section id="trayectoria" class="wrap section">
      <h2 class="h2" style="margin-bottom: 12px">{tx.pathTitle}</h2>
      <p class="muted" style="max-width: 620px; margin-bottom: 36px">{tx.pathLead}</p>
      <div style="overflow-x: auto; border: 1px solid var(--line); border-radius: 20px; background: var(--surface)">
        <div class="col gap12" style="min-width: 720px; padding: 28px 28px 20px">
          <div class="row gap16">
            <div class="lane-label"></div>
            <div class="mono small muted" style="position: relative; flex: 1; height: 18px">
              <span style="position: absolute; left: 0">2023</span><span style="position: absolute; left: 16.7%">2024</span><span style="position: absolute; left: 45.2%">2025</span><span style="position: absolute; left: 73.8%">2026</span><span style="position: absolute; right: 0">{tx.today}</span>
            </div>
          </div>
          {
            tx.lanes.map((l) => (
              <div class="row gap16 center">
                <div class="lane-label" style="font-size: 14px; font-weight: 600">{l.name}</div>
                <div class="lane-track">
                  <div class="lane-bar" style={`left:${l.left}%;width:${l.width}%;background:${laneColor[l.color][0]};color:${laneColor[l.color][1]}`}>
                    <span class="mono" style="font-size: 11px; padding: 0 10px; white-space: nowrap">{l.kind}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <ol class="roles">
        {
          tx.roles.map((r) => (
            <li>
              <span class="mono muted" style="width: 170px; font-size: 13px; padding-top: 3px">{r.dates}</span>
              <div class="col" style="flex: 1 1 420px; gap: 4px">
                <span style="font-weight: 600">{r.role} · <span class="sea">{r.org}</span></span>
                <span class="muted">{r.line}</span>
              </div>
              <span class="mono small muted" style="padding-top: 3px">{r.kind}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="stack" class="wrap section">
      <h2 class="h2" style="margin-bottom: 36px">{tx.stackTitle}</h2>
      <div class="grid-auto" style="--min: 260px; gap: 24px">
        {
          tx.stack.map((s) => (
            <div class="col gap12" style="padding-top: 18px; border-top: 2px solid var(--ink)">
              <h3 style="font-family: inherit; font-size: 18px; font-weight: 600">{s.area}</h3>
              <p class="mono" style="font-size: 13px; line-height: 1.8">{s.tools}</p>
              <p class="muted" style="font-size: 14px">{s.where}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap col gap28" style="padding-top: 96px; padding-bottom: 48px">
        <h2 class="contact-title">{tx.contactTitle[0]}<em>{tx.contactTitle[1]}</em>{tx.contactTitle[2]}</h2>
        <div class="row wrap-gap gap12">
          <button type="button" class="btn" style="background: var(--bg); color: var(--ink); border: 0" data-copy={links.email} data-copied={tx.hero.copied}>{tx.hero.copy}</button>
          <a href={links.whatsapp} class="btn btn-line">WhatsApp</a>
          <a href={links.telegram} class="btn btn-line">Telegram</a>
          <a href={links.linkedin} class="btn btn-line">LinkedIn</a>
          <a href={links.github} class="btn btn-line">GitHub</a>
        </div>
        <div class="row between wrap-gap mono small" style="padding-top: 48px; opacity: 0.75">
          <span>{tx.rights}</span>
          <span>{tx.place} · <span data-clock>--:--</span> {tx.localTime}</span>
        </div>
      </div>
    </section>
  </main>
</Site>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .contour { position: absolute; top: 0; bottom: 0; left: 0; width: calc(100% + 60px); height: 100%; opacity: 0.55; animation: drift 26s ease-in-out infinite; }
  .hero-inner { position: relative; padding-top: 112px; padding-bottom: 96px; }
  .hero-title { max-width: 980px; font-size: clamp(44px, 6.4vw, 88px); line-height: 1.02; letter-spacing: -0.01em; }
  .hero-lead { max-width: 640px; font-size: 19px; }
  .card-title { font-size: 36px; }
  .visual { height: 200px; border-radius: 14px; padding: 18px; display: flex; position: relative; overflow: hidden; }
  .visual .fill { position: absolute; inset: 0; width: 100%; height: 100%; }
  .qr-visual { align-items: center; justify-content: space-between; gap: 12px; }
  .qr-phone { width: 120px; height: 150px; border-radius: 16px; border: 2px solid var(--ink); background: var(--bg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; flex-shrink: 0; }
  .qr-pos { width: 170px; height: 150px; border-radius: 12px; border: 2px solid var(--ink); background: var(--bg); padding: 12px; display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }
  .ticket { position: absolute; left: 150px; top: 78px; padding: 8px 12px; border-radius: 10px; background: var(--ink); color: var(--bg); font-size: 12px; white-space: nowrap; animation: ticket 5s ease-in-out infinite; }
  .ping { font-size: 12px; padding: 6px 8px; border-radius: 8px; background: var(--seaSoft); color: var(--sea); animation: ping 5s ease-in-out infinite; }
  .bubble-in { align-self: flex-start; max-width: 80%; padding: 10px 14px; border-radius: 14px 14px 14px 4px; background: var(--surface); font-size: 15px; }
  .bubble-out { align-self: flex-end; max-width: 80%; padding: 10px 14px; border-radius: 14px 14px 4px 14px; background: var(--sea); color: var(--bg); font-size: 15px; }
  .lane-label { width: 150px; flex-shrink: 0; }
  .lane-track { position: relative; flex: 1; height: 30px; background-image: linear-gradient(to right, var(--line) 1px, transparent 1px); background-size: 16.66% 100%; }
  .lane-bar { position: absolute; top: 0; bottom: 0; border-radius: 8px; display: flex; align-items: center; overflow: hidden; }
  .roles { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-direction: column; }
  .roles li { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 20px 0; border-top: 1px solid var(--line); }
  .contact { margin-top: 96px; background: var(--ink); color: var(--bg); }
  .contact-title { font-size: clamp(44px, 6vw, 80px); line-height: 1.05; }
  .btn-line { border: 1px solid var(--bg); color: var(--bg); }
  .btn-line:hover { color: var(--bg); opacity: 0.85; }
  @keyframes drift { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-36px); } }
  @keyframes ticket { 0%, 12% { transform: translateX(0); opacity: 0; } 22% { opacity: 1; } 55%, 100% { transform: translateX(178px); opacity: 1; } }
  @keyframes ping { 0%, 55% { opacity: 0; } 62%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .contour, .ticket, .ping { animation: none; }
    .ticket { transform: translateX(178px); }
  }
  @media (max-width: 760px) {
    .hero-inner { padding-top: 72px; padding-bottom: 64px; }
    .lane-label { width: 96px; }
    .qr-pos { width: 140px; }
    .ticket { display: none; }
  }
</style>

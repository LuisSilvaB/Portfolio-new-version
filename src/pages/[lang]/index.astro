---
import Site from '@/layouts/Site.astro';
import { t, poster, links, langs, type Lang } from '@/content/site';

export const prerender = true;
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const tx = t[lang];
const px = poster[lang];
// card palettes: paper / black / red / paper
const pal = [
  { bg: 'var(--paper)', fg: 'var(--ink)', num: 'var(--red)' },
  { bg: '#0a0a0a', fg: '#ecebe6', num: '#ff5a3d' },
  { bg: '#ff3b1f', fg: '#0a0a0a', num: '#0a0a0a' },
  { bg: 'var(--paper)', fg: 'var(--ink)', num: 'var(--red)' },
];
const ticker = [...px.ticker, ...px.ticker];
---

<Site lang={lang} title={tx.meta.title} description={tx.meta.description} home>
  <main>
    <section class="pad hero">
      <span class="caps muted">{px.edition}</span>
      <h1 class="display name">
        <span class="mask"><span>Luis</span></span>
        <span class="mask"><span class="outline">Silva</span></span>
      </h1>
      <div class="hero-foot">
        <p class="lead">{px.lead[0]}<mark>{px.lead[1]}</mark>{px.lead[2]}</p>
        <div class="row gap10 wrap">
          <a href="#obra" class="btn">{px.ctaWork}</a>
          <a href={tx.hero.cv} class="btn" download>CV ↓</a>
        </div>
      </div>
    </section>

    <div class="breaking">
      <span class="cond breaking-label">{px.breaking}</span>
      <div class="ticker cond" aria-hidden="true">{ticker.map((x) => <span>■ {x}</span>)}</div>
    </div>

    <section id="obra" class="pad cards">
      {
        px.cards.map((c, i) => (
          <a
            href={c.href}
            class="card hover-color"
            style={`top:${20 + i * 24}px;background:${pal[i].bg};color:${pal[i].fg}`}
          >
            <div class="card-grid">
              <div class="card-text">
                <div class="row between caps"><span>{c.tag}</span><span>{c.dates}</span></div>
                <div class="col gap14">
                  <span class="display num" style={`color:${pal[i].num}`}>{c.n}</span>
                  <h2 class="display card-name"><span class="hl">{c.name}</span></h2>
                  <p class="cond card-headline">{c.headline}</p>
                  <p class="card-desc">{c.desc}</p>
                </div>
                <div class="stats">
                  {c.stats.map((s) => (
                    <div>
                      <div class="display stat-n">{s.n}</div>
                      <div class="caps stat-l">{s.l}</div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="shot-frame">
                {c.img ? (
                  <img class="photo" src={c.img} alt={c.alt} loading={i === 0 ? 'eager' : 'lazy'} />
                ) : (
                  c.chat && (
                    <div class="photo chat" role="img" aria-label={c.alt}>
                      <span class="b-in">{c.chat.in}</span>
                      <span class="b-out">{c.chat.out}</span>
                      <span class="b-actions"><span>{c.chat.yes}</span><span>{c.chat.no}</span></span>
                    </div>
                  )
                )}
                <span class="see caps">{c.href.startsWith('http') ? px.seeDemo : px.seeCase}</span>
              </div>
            </div>
          </a>
        ))
      }
    </section>

    <section class="pad extra">
      <div class="jobs">
        {
          tx.roles.map((r) => (
            <div class="job">
              <span class="caps muted">{r.dates}</span>
              <span class="display" style="font-size: 26px">{r.org}</span>
              <span style="font-size: 13px">{r.role} · {r.kind}</span>
            </div>
          ))
        }
      </div>
      <aside class="classifieds">
        <span class="cond" style="font-size: 34px; line-height: 1; border-bottom: 2px solid var(--ink); padding-bottom: 8px">{px.classifiedsTitle}</span>
        <p style="font-size: 14px">{px.classifieds}</p>
        <span class="available">{px.available}</span>
      </aside>
    </section>

    <section id="hablemos" class="pad talk">
      <h2 class="display talk-title">{px.talk[0]}<br />{px.talk[1]}</h2>
      <div class="row gap10 wrap" style="padding-top: 32px">
        <button type="button" class="btn btn-solid" data-copy={links.email} data-copied={tx.hero.copied}>{tx.hero.copy}</button>
        <a href={links.whatsapp} class="btn btn-on-red">WhatsApp ↗</a>
        <a href={links.telegram} class="btn btn-on-red">Telegram ↗</a>
        <a href={links.linkedin} class="btn btn-on-red">LinkedIn ↗</a>
        <a href={links.github} class="btn btn-on-red">GitHub ↗</a>
      </div>
      <div class="row between wrap caps" style="padding-top: 48px">
        <span>{tx.rights}</span>
        <span>{links.email}</span>
      </div>
    </section>
  </main>
</Site>

<style>
  .between { justify-content: space-between; }
  .wrap { flex-wrap: wrap; }
  .gap10 { gap: 10px; }
  .col { display: flex; flex-direction: column; }
  .gap14 { gap: 14px; }
  .hero { padding-top: 48px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 8px; }
  .name { font-size: clamp(72px, 15vw, 230px); line-height: 0.86; }
  .name .mask { padding: 0.06em 0; margin: -0.06em 0; }
  .outline { color: transparent; -webkit-text-stroke: 3px var(--ink); background: linear-gradient(var(--red), var(--red)) no-repeat 0 0 / 0% 100%; -webkit-background-clip: text; background-clip: text; }
  /* ponytail: el relleno corre solo en loop, sin depender del cursor */
  .mask > .outline { animation: up 0.9s 0.12s cubic-bezier(0.77, 0, 0.175, 1) both, fill 7s 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  .hero-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; align-items: flex-end; padding-top: 24px; border-top: 2px solid var(--ink); }
  .lead { max-width: 560px; font-size: 18px; line-height: 1.5; }
  mark { background: var(--red); color: #0a0a0a; padding: 0 4px; }
  .breaking { display: flex; overflow: hidden; background: var(--red); color: #0a0a0a; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .breaking-label { flex-shrink: 0; padding: 10px 16px; background: #0a0a0a; color: #ff3b1f; font-size: 24px; z-index: 1; }
  .ticker { display: flex; gap: 48px; width: max-content; padding: 10px 0 10px 24px; font-size: 24px; white-space: nowrap; animation: ticker 32s linear infinite; }
  .cards { padding-top: 48px; display: flex; flex-direction: column; gap: 32px; }
  .card { position: sticky; display: block; padding: 32px; border: 2px solid var(--ink); text-decoration: none; box-shadow: 0 -12px 0 var(--bg); }
  .card:hover { color: inherit; }
  .card-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: stretch; }
  .card-text { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .num { font-size: 120px; line-height: 0.8; }
  .card-name { font-size: 56px; line-height: 0.9; }
  .hl { background: linear-gradient(var(--red), var(--red)) no-repeat 0 88% / 0% 22%; transition: background-size 0.45s ease; }
  .card:hover .hl { background-size: 100% 22%; }
  .card-headline { font-size: 30px; line-height: 0.95; max-width: 460px; }
  .card-desc { font-size: 15px; max-width: 440px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; border-top: 2px solid currentColor; padding-top: 14px; }
  .stat-n { font-size: 26px; line-height: 1; }
  .stat-l { font-size: 11px; opacity: 0.8; }
  .shot-frame { position: relative; border: 2px solid currentColor; overflow: hidden; min-height: 440px; background: #fff; }
  .shot-frame img { display: block; width: 100%; height: 100%; min-height: 440px; object-fit: cover; object-position: top; }
  .chat { position: absolute; inset: 0; background: #e7f5ee; display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 40px; color: #0a0a0a; font-family: system-ui, sans-serif; font-size: 18px; }
  .b-in { align-self: flex-start; padding: 14px 18px; border-radius: 16px 16px 16px 4px; background: #fff; }
  .b-out { align-self: flex-end; padding: 14px 18px; border-radius: 16px 16px 4px 16px; background: #0f7a55; color: #fff; }
  .b-actions { align-self: flex-end; display: flex; gap: 8px; }
  .b-actions span { padding: 10px 16px; border: 2px solid #0f7a55; border-radius: 999px; color: #0f7a55; }
  .see { position: absolute; right: 12px; bottom: 12px; padding: 6px 10px; background: #0a0a0a; color: #ecebe6; }
  .extra { padding-top: 96px; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 32px; }
  .jobs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-top: 2px solid var(--ink); }
  .job { padding: 18px 16px 18px 0; border-bottom: 2px solid var(--ink); display: flex; flex-direction: column; gap: 4px; }
  .classifieds { border: 2px solid var(--ink); padding: 20px; display: flex; flex-direction: column; gap: 12px; align-self: start; background: var(--paper); }
  .available { align-self: flex-start; background: var(--red); color: #0a0a0a; padding: 2px 8px; font-size: 13px; font-weight: 700; }
  .talk { margin-top: 96px; background: var(--red); color: #0a0a0a; padding-top: 64px; padding-bottom: 40px; border-top: 2px solid var(--ink); }
  .talk a, .talk span { color: #0a0a0a; }
  .talk .btn-solid { color: #ecebe6; }
  .talk-title { font-size: clamp(64px, 13vw, 200px); line-height: 0.86; }
  @keyframes fill {
    0% { background-size: 0% 100%; background-position: left top; }
    40%, 55% { background-size: 100% 100%; background-position: left top; }
    56% { background-position: right top; }
    90%, 100% { background-size: 0% 100%; background-position: right top; }
  }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker, .mask > .outline { animation: none; }
    .hl { transition: none; }
  }
  @media (max-width: 860px) {
    .card { position: relative; top: auto !important; padding: 20px; }
    .card-grid, .extra { grid-template-columns: minmax(0, 1fr); }
    .num { font-size: 80px; }
    .card-name { font-size: 40px; }
    .shot-frame, .shot-frame img { min-height: 260px; }
    .outline { -webkit-text-stroke-width: 2px; }
    .stat-n { font-size: 20px; }
    .chat { padding: 20px 20px 56px; font-size: 15px; }
  }
</style>
